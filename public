<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>India's Food Security</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Hind:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f6f3ec;--card:#fffdf8;--ink:#1d2a1f;--mute:#5d6b5f;--line:#d9d3c3;--saff:#e07b1a;--green:#2e6b3a;--ind:#2b4a7a;--bad:#b3392b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141a15;--card:#1c241d;--ink:#eee9db;--mute:#a3aea5;--line:#34402f;--saff:#f09a45;--green:#6fbf80;--ind:#8fb0e6;--bad:#e8806f}}
:root[data-theme="dark"]{--bg:#141a15;--card:#1c241d;--ink:#eee9db;--mute:#a3aea5;--line:#34402f;--saff:#f09a45;--green:#6fbf80;--ind:#8fb0e6;--bad:#e8806f}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 Hind,system-ui,sans-serif}
.wrap{max-width:860px;margin:0 auto;padding:20px 18px 60px}
h1,h2,h3{font-family:Fraunces,Georgia,serif;line-height:1.15;margin:0}
h1{font-size:clamp(2rem,6vw,3.2rem);font-weight:800;letter-spacing:-.02em}
h2{font-size:1.5rem;margin:6px 0 10px}
h3{font-size:1.1rem}
.lede{color:var(--mute);max-width:60ch;margin:10px 0 18px}
.flag{height:6px;border-radius:3px;background:linear-gradient(90deg,var(--saff) 33%,#fff 33% 66%,var(--green) 66%);margin-bottom:16px;border:1px solid var(--line)}
nav{display:flex;gap:6px;overflow-x:auto;border-bottom:1px solid var(--line);margin-bottom:22px}
nav button{background:none;border:0;border-bottom:3px solid transparent;color:var(--mute);font:inherit;font-weight:600;padding:10px 12px;cursor:pointer;white-space:nowrap}
nav button[aria-selected=true]{color:var(--ink);border-color:var(--saff)}
button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid var(--ind);outline-offset:2px}
section{display:none}section.on{display:block}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.box{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:14px}
.big{font:800 2.1rem Fraunces,Georgia,serif;color:var(--green)}
.small{font-size:.88rem;color:var(--mute)}
.pill{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:2px 10px;font-size:.82rem;color:var(--mute);margin:0 4px 4px 0}
.bars{margin:12px 0}
.row{display:grid;grid-template-columns:130px 1fr;gap:10px;align-items:center;margin:8px 0;font-size:.92rem}
.track{display:flex;flex-direction:column;gap:3px}
.b{height:16px;border-radius:2px;display:flex;align-items:center;justify-content:flex-end;padding-right:5px;color:#fff;font-size:.75rem;font-weight:600;min-width:28px}
.b.o{background:var(--ind)}.b.n{background:var(--saff)}
.leg span{margin-right:14px;font-size:.85rem}.leg i{display:inline-block;width:12px;height:12px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.acc{background:var(--card);border:1px solid var(--line);border-radius:6px;margin:8px 0}
.acc>button{width:100%;text-align:left;background:none;border:0;padding:13px 14px;font:inherit;font-weight:600;color:var(--ink);cursor:pointer;display:flex;justify-content:space-between;gap:10px}
.acc .body{display:none;padding:0 14px 14px;color:var(--mute)}
.acc.open .body{display:block}
.acc.open>button span:last-child{transform:rotate(45deg)}
label{display:block;font-weight:600;margin:12px 0 4px}
select,input{font:inherit;padding:9px 10px;border:1px solid var(--line);border-radius:5px;background:var(--card);color:var(--ink);width:100%;max-width:340px}
.res{margin-top:16px;border-left:5px solid var(--green)}
.cta{background:var(--green);color:#fff;border:0;border-radius:5px;padding:10px 16px;font:inherit;font-weight:600;cursor:pointer;margin-top:14px}
.q button{display:block;width:100%;text-align:left;margin:6px 0;padding:10px 12px;border:1px solid var(--line);border-radius:5px;background:var(--card);color:var(--ink);font:inherit;cursor:pointer}
.q button.ok{border-color:var(--green);background:color-mix(in srgb,var(--green) 18%,var(--card))}
.q button.no{border-color:var(--bad)}
footer{margin-top:34px;font-size:.82rem;color:var(--mute);border-top:1px solid var(--line);padding-top:12px}

.gc{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}
.gc button{border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;padding:6px 12px;border-radius:99px;cursor:pointer}
.gc button.on{background:var(--green);color:#fff;border-color:var(--green)}
.gr{display:grid;grid-template-columns:150px 1fr 56px;gap:8px;align-items:center;font-size:.88rem;margin:3px 0}
.gr .bb{height:12px;border-radius:2px;background:var(--saff)}
.gr span:last-child{text-align:right;font-variant-numeric:tabular-nums}
@media(max-width:480px){.gr{grid-template-columns:105px 1fr 50px}}
</style>
</head>
<body>
<div class="wrap">
<div class="flag"></div>
<h1>India's food security</h1>
<p class="lede">Feeding 1.4 billion people: how much India grows, who gets subsidised grain, and where hunger and malnutrition still persist.</p>
<nav role="tablist" id="nav"></nav>

<section id="s0" class="on">
<h2>The four pillars</h2>
<p class="small">The FAO defines food security as all people having reliable access to enough safe, nutritious food. Tap each pillar to see India's position.</p>
<div id="pillars"></div>
<h2 style="margin-top:26px">Key numbers</h2>
<div class="grid">
<div class="box"><div class="big">~81 crore</div><div class="small">people covered by free grain under the National Food Security Act (NFSA) and PMGKAY</div></div>
<div class="box"><div class="big">~330 MT</div><div class="small">foodgrain production, 2022-23 (approx.), a record at the time</div></div>
<div class="box"><div class="big">105 / 127</div><div class="small">India's rank in the Global Hunger Index 2024, scored "serious"</div></div>
<div class="box"><div class="big">~5 lakh</div><div class="small">Fair Price Shops in the Public Distribution System</div></div>
</div>
</section>

<section id="s1">
<h2>Growing more, but eating well?</h2>
<p class="small">Production (million tonnes, approx.) has risen steadily. The gap is nutrition, not calories alone.</p>
<div class="bars" id="prod"></div>
<h2 style="margin-top:26px">Nutrition: NFHS-4 vs NFHS-5</h2>
<p class="small">National Family Health Survey, % of group affected. Stunting, wasting and underweight improved; anaemia got worse.</p>
<div class="leg"><span><i style="background:var(--ind)"></i>NFHS-4 (2015-16)</span><span><i style="background:var(--saff)"></i>NFHS-5 (2019-21)</span></div>
<div class="bars" id="nfhs"></div>
</section>

<section id="s2">
<h2>Major schemes</h2>
<p class="small">Tap a scheme for what it does.</p>
<div id="schemes"></div>
</section>

<section id="s3">
<h2>Ration entitlement calculator</h2>
<p class="small">Estimate the monthly free grain a household can receive under NFSA.</p>
<label for="ct">Ration card type</label>
<select id="ct"><option value="aay">Antyodaya Anna Yojana (AAY)</option><option value="phh" selected>Priority Household (PHH)</option><option value="none">No NFSA card</option></select>
<label for="mem">Household members</label>
<input id="mem" type="number" min="1" max="30" value="4">
<button class="cta" id="calc">Calculate entitlement</button>
<div class="box res" id="out" aria-live="polite" hidden></div>
</section>

<section id="s4">
<h2>Quick quiz</h2>
<div class="q" id="quiz"></div>
</section>

<section id="s5"><h2>State graphs</h2><p class="small" id="gsub"></p><div class="gc" id="gc"></div><div id="gb"></div><p class="small" id="gn" style="margin-top:12px"></p></section>
<footer>Figures are approximate and drawn from NFSA, FAO, NFHS-5 and Global Hunger Index reports as generally published. Scheme rules change, so check the Department of Food and Public Distribution (dfpd.gov.in) or your state food department for current details.</footer>
</div>
<script>
const tabs=["Overview","Data","Schemes","Calculator","Quiz","State graphs"];
const nav=document.getElementById("nav");
tabs.forEach((t,i)=>{const b=document.createElement("button");b.textContent=t;b.setAttribute("role","tab");b.setAttribute("aria-selected",i==0);b.onclick=()=>{nav.querySelectorAll("button").forEach((x,j)=>x.setAttribute("aria-selected",i==j));document.querySelectorAll("section").forEach((s,j)=>s.classList.toggle("on",i==j))};nav.appendChild(b)});

function acc(el,items){items.forEach(([h,b])=>{const d=document.createElement("div");d.className="acc";d.innerHTML=`<button aria-expanded="false"><span>${h}</span><span aria-hidden="true">+</span></button><div class="body">${b}</div>`;d.firstChild.onclick=()=>{const o=d.classList.toggle("open");d.firstChild.setAttribute("aria-expanded",o)};el.appendChild(d)})}
acc(document.getElementById("pillars"),[
["Availability","India is a major producer of rice, wheat, milk and pulses and has been a net food exporter. Buffer stocks held by the Food Corporation of India (FCI) cushion bad harvests. Pulses and edible oils are still partly imported."],
["Access","The Public Distribution System, NFSA entitlements and One Nation One Ration Card (portability across states) aim to make grain affordable. Leakages and exclusion errors remain, though digitisation of ration cards and Aadhaar-linked distribution has reduced them."],
["Utilisation","Eating enough calories is not the same as being well nourished. Diets rely heavily on cereals; protein, fruit, vegetables and micronutrients lag. Clean water, sanitation and health care also decide whether food is absorbed."],
["Stability","Monsoon dependence, heat waves, floods and price spikes (for example onions, tomatoes, pulses) can disrupt food security. Minimum Support Prices, stock limits and export curbs are used to steady markets."]]);
acc(document.getElementById("schemes"),[
["National Food Security Act, 2013","Legal right to subsidised grain: up to 75% of rural and 50% of urban population. Priority households get 5 kg per person per month; AAY households (the poorest) get 35 kg per household. Also guarantees meals for children, pregnant women and nursing mothers."],
["PM Garib Kalyan Anna Yojana (PMGKAY)","Began as COVID relief in 2020. From January 2024 the Centre made NFSA grain free for about 81 crore beneficiaries for five years."],
["Public Distribution System (PDS)","Centre buys grain at MSP through FCI; states distribute it via Fair Price Shops. Many states now use e-PoS machines to verify beneficiaries."],
["One Nation One Ration Card","Lets migrant workers collect their entitlement from any Fair Price Shop in the country using the same card."],
["PM POSHAN (mid-day meal)","Hot cooked meals in government and aided schools for primary and upper-primary students, supporting both nutrition and attendance."],
["Saksham Anganwadi and Poshan 2.0","Anganwadi centres deliver supplementary nutrition, early childhood care and health checks for young children, adolescent girls, pregnant women and nursing mothers."],
["Fortified rice","Rice fortified with iron, folic acid and vitamin B12 is being supplied through government schemes to tackle anaemia and micronutrient gaps."]]);

function bars(id,data,pair){const el=document.getElementById(id);data.forEach(([l,a,b])=>{const mx=pair?70:340;const r=document.createElement("div");r.className="row";let h=`<div>${l}</div><div class="track"><div class="b ${pair?'o':'n'}" style="width:${a/mx*100}%">${a}${pair?'%':''}</div>`;if(pair)h+=`<div class="b n" style="width:${b/mx*100}%">${b}%</div>`;r.innerHTML=h+"</div>";el.appendChild(r)})}
bars("prod",[["2010-11",245],["2015-16",252],["2020-21",311],["2022-23",330]],false);
bars("nfhs",[["Stunting (under 5)",38.4,35.5],["Wasting (under 5)",21.0,19.3],["Underweight (under 5)",35.8,32.1],["Anaemia, children 6-59 mo",58.6,67.1],["Anaemia, women 15-49",53.1,57.0]],true);

document.getElementById("calc").onclick=()=>{
const t=document.getElementById("ct").value,n=Math.max(1,Math.min(30,+document.getElementById("mem").value||1)),o=document.getElementById("out");
let kg,msg;
if(t=="aay"){kg=35;msg="AAY households receive a fixed 35 kg per household per month, regardless of size."}
else if(t=="phh"){kg=5*n;msg=`Priority households receive 5 kg per person: ${n} × 5 kg.`}
else{o.hidden=false;o.innerHTML="<h3>No NFSA entitlement</h3><p>Without an NFSA ration card, the household does not get subsidised grain under the Act. Check eligibility with your state food department or apply through your state's food portal. Some states run their own additional schemes.</p>";return}
o.hidden=false;o.innerHTML=`<h3>${kg} kg of grain per month</h3><p>${msg}</p><p class="small">That is about ${kg*12} kg a year, issued free under PMGKAY. Grain type (rice, wheat or millets) and extras such as pulses or sugar vary by state.</p>`};

const Q=[["Which Act gives a legal right to subsidised foodgrain in India?",["Essential Commodities Act","National Food Security Act, 2013","Food Safety Act, 2006"],1],
["How much grain does a Priority Household get per person each month?",["2 kg","5 kg","10 kg"],1],
["Which agency buys grain at MSP and holds buffer stocks?",["NABARD","FCI","FSSAI"],1],
["What does One Nation One Ration Card help with?",["Collecting rations in any state","Opening a bank account","Cooking gas subsidy"],0]];
const qz=document.getElementById("quiz");let score=0,done=0;
Q.forEach(([q,o,a])=>{const d=document.createElement("div");d.className="box";d.style.marginBottom="12px";d.innerHTML=`<h3>${q}</h3>`;o.forEach((t,i)=>{const b=document.createElement("button");b.textContent=t;b.onclick=()=>{if(d.dataset.d)return;d.dataset.d=1;done++;b.classList.add(i==a?"ok":"no");if(i==a)score++;else d.querySelectorAll("button")[a].classList.add("ok");if(done==Q.length){const s=document.createElement("p");s.innerHTML=`<strong>Score: ${score} / ${Q.length}</strong>`;qz.appendChild(s)}};d.appendChild(b)});qz.appendChild(d)});

const G={
"India: rural coverage":{u:"% of rural population entitled to subsidised grain under NFSA (2011-12 NSSO basis). Source: nfsa.gov.in",n:"This is the legal coverage ceiling per state, not a hunger rate.",d:"Andhra Pradesh:60.96;Arunachal Pradesh:66.31;Assam:84.17;Bihar:85.12;Chhattisgarh:84.25;Delhi:37.69;Goa:42.24;Gujarat:74.64;Haryana:54.61;Himachal Pradesh:56.23;Jammu & Kashmir:63.55;Jharkhand:86.48;Karnataka:76.04;Kerala:52.63;Madhya Pradesh:80.10;Maharashtra:76.32;Manipur:88.56;Meghalaya:77.79;Mizoram:81.88;Nagaland:79.83;Odisha:82.17;Punjab:54.79;Rajasthan:69.09;Sikkim:75.74;Tamil Nadu:62.55;Telangana:60.96;Tripura:74.75;Uttar Pradesh:79.56;Uttarakhand:65.26;West Bengal:74.47;A&N Islands:24.94;Chandigarh:38.54;Dadra & Nagar Haveli:84.19;Daman & Diu:26.66;Lakshadweep:35.30;Puducherry:59.68"},
"India: urban coverage":{u:"% of urban population entitled to subsidised grain under NFSA (2011-12 NSSO basis). Source: nfsa.gov.in",n:"This is the legal coverage ceiling per state, not a hunger rate.",d:"Andhra Pradesh:41.14;Arunachal Pradesh:51.55;Assam:60.35;Bihar:74.53;Chhattisgarh:59.98;Delhi:43.59;Goa:33.02;Gujarat:48.25;Haryana:41.05;Himachal Pradesh:30.99;Jammu & Kashmir:47.10;Jharkhand:60.20;Karnataka:49.36;Kerala:39.50;Madhya Pradesh:62.61;Maharashtra:45.34;Manipur:85.75;Meghalaya:50.87;Mizoram:48.60;Nagaland:61.98;Odisha:55.77;Punjab:44.83;Rajasthan:53.00;Sikkim:40.36;Tamil Nadu:37.79;Telangana:41.14;Tripura:49.54;Uttar Pradesh:64.43;Uttarakhand:52.05;West Bengal:47.55;A&N Islands:1.70;Chandigarh:47.26;Dadra & Nagar Haveli:51.54;Daman & Diu:56.47;Lakshadweep:33.56;Puducherry:46.94"},
"USA":{u:"% of households food insecure, 3-year average 2022-24 (USDA ERS, all 50 states + DC). US average 13.3%.",n:"Margins of error are about 1-3 points. USDA has discontinued this report.",d:"Alabama:12.1;Alaska:13.0;Arizona:13.1;Arkansas:19.4;California:12.5;Colorado:10.5;Connecticut:12.1;Delaware:10.8;D.C.:10.3;Florida:13.3;Georgia:14.6;Hawaii:10.8;Idaho:12.6;Illinois:13.3;Indiana:13.7;Iowa:10.8;Kansas:12.5;Kentucky:18.8;Louisiana:17.7;Maine:12.9;Maryland:11.5;Massachusetts:11.7;Michigan:14.7;Minnesota:9.9;Mississippi:17.3;Missouri:13.3;Montana:11.7;Nebraska:12.7;Nevada:15.0;New Hampshire:9.1;New Jersey:9.8;New Mexico:14.5;New York:14.0;North Carolina:11.8;North Dakota:9.0;Ohio:14.2;Oklahoma:16.9;Oregon:12.5;Pennsylvania:10.9;Rhode Island:10.6;South Carolina:13.5;South Dakota:9.5;Tennessee:13.3;Texas:17.6;Utah:11.5;Vermont:9.4;Virginia:12.4;Washington:11.0;West Virginia:14.1;Wisconsin:12.0;Wyoming:15.6"},
"Canada":{u:"% of people in food-insecure households, 2025 (Statistics Canada via PROOF). Canada overall 24.0%. Only 8 of 13 provinces/territories verified.",n:"Not shown: SK, NS, PEI, ON, BC. Northwest Territories estimate is flagged for data quality.",d:"Nunavut:56.4;Alberta:28.4;New Brunswick:28.2;Manitoba:27.9;Newfoundland & Labrador:25.5;Quebec:18.0;Northwest Territories:16.4;Yukon:15.5"},
"Brazil":{u:"% of households food insecure, 2023 (IBGE). 10 of 27 states: the 5 best and 5 worst. National 27.6%.",n:"Insecure share = 100 minus the published food-secure share (calculated).",d:"Santa Catarina:11.2;Paraná:17.9;Rio Grande do Sul:18.7;Espírito Santo:20.8;Minas Gerais:21.6;Piauí:42.0;Amazonas:42.6;Maranhão:43.6;Pará:47.7;Sergipe:49.2"}};
const gc=document.getElementById("gc");
function showG(k){gc.querySelectorAll("button").forEach(b=>b.classList.toggle("on",b.textContent==k));
const g=G[k],rows=g.d.split(";").map(x=>{const i=x.lastIndexOf(":");return[x.slice(0,i),+x.slice(i+1)]}).sort((a,b)=>b[1]-a[1]),mx=Math.max(...rows.map(r=>r[1]));
document.getElementById("gsub").textContent=g.u;document.getElementById("gn").textContent=g.n;
document.getElementById("gb").innerHTML=rows.map(([n,v])=>`<div class="gr"><span>${n}</span><div><div class="bb" style="width:${v/mx*100}%"></div></div><span>${v.toFixed(1)}%</span></div>`).join("")}
Object.keys(G).forEach(k=>{const b=document.createElement("button");b.textContent=k;b.onclick=()=>showG(k);gc.appendChild(b)});showG("India: rural coverage");
</script>
</body>
</html>
